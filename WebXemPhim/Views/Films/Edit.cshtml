@model WebXemPhim.Models.Film

@{
    ViewBag.Title = "Chỉnh sửa phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-light shadow-lg border-0 rounded-3">
                <div class="card-body p-4">
                    <h2 class="mb-4 text-center">Chỉnh sửa phim</h2>
                    @using (Html.BeginForm("Edit", "Films", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.FilmId)

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Title, "Tên", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control bg-secondary text-light" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.OriginalTitle, "Tên gốc", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.OriginalTitle, new { @class = "form-control bg-secondary text-light" })
                            @Html.ValidationMessageFor(m => m.OriginalTitle, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, "Mô tả", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Description, 4, 0, new { @class = "form-control bg-secondary text-light", @style = "resize:vertical" })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.ReleaseYear, "Năm phát hành", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.ReleaseYear, new { @class = "form-control bg-secondary text-light", type = "number" })
                            @Html.ValidationMessageFor(m => m.ReleaseYear, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Thể loại</label>
                            @Html.ListBox("SelectedGenreIds", ViewBag.SelectedGenreIds as MultiSelectList, new { @class = "form-control bg-secondary text-light", style = "height:150px;" })
                        </div>
                        <div class="mb-3">
                            <div class="form-check d-inline-block me-3">
                                @Html.CheckBoxFor(m => m.IsMovie, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsMovie, "Phim Lẻ", new { @class = "form-check-label" })
                            </div>
                            <div class="form-check d-inline-block">
                                @Html.CheckBoxFor(m => m.IsCompleted, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsCompleted, "Hoàn thành", new { @class = "form-check-label" })
                            </div>
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EpsisodeCount, "Tập", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EpsisodeCount, new { @class = "form-control bg-secondary text-light", type = "number" })
                            @Html.ValidationMessageFor(m => m.EpsisodeCount, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ảnh poster phim</label>
                            <input type="file" name="Thumbnail" class="form-control bg-secondary text-light" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            @Html.ValidationMessage("Thumbnail", "", new { @class = "text-danger" })
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-block">Lưu thay đổi</button>
                        </div>
                        <div class="mt-3 text-center">
                            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-light" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
