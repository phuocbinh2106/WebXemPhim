@model WebXemPhim.Models.Film
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="background:#232323; border-radius:12px; padding:36px 26px; margin-top:22px;">
    <!-- Poster Left -->
    <div class="film-details-card row">
        @{
            // Lấy tập đầu tiên, lấy episode có số nhỏ nhất hoặc null
            var firstEp = (Model.Episodes != null && Model.Episodes.Any())
                ? Model.Episodes.OrderBy(e => e.EpisodeNumber).FirstOrDefault()
                : null;
        }
        <!-- Poster -->
        <div class="col-md-3 col-12 d-flex flex-column align-items-center">
            <div class="film-details-main">
                <div class="film-details-poster-col">
                    <img src="@Url.Content(Model.ThumbnailUrl)" class="film-details-poster rounded" alt="@Model.Title"
                         style="width: 200.98px; height: 301.46px; object-fit: cover;" />
                    @if (firstEp != null)
                    {
                        <a href="@Url.Action("Watch", "Episodes", new { id = firstEp.EpisodeId })" class="btn btn-warning mt-2">
                            <i class="fa fa-play"></i> Xem Phim
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-warning mt-2" disabled>
                            <i class="fa fa-play"></i> Không có tập để xem
                        </button>
                    }
                </div>
            </div>
            <!-- Info -->
            <div class="film-details-info-col flex-grow-1">
                <div class="film-details-block">
                    <span class="label-detail">Tên</span>
                    <span class="film-details-title ms-2">@Model.Title</span>
                </div>
                <div class="divider-line"></div>
                <div class="film-details-block">
                    <span class="label-detail">Tên Khác</span>
                    <span class="film-details-othertitle ms-2">@Model.OriginalTitle</span>
                </div>
                <div class="divider-line"></div>
                <div class="film-details-block d-flex align-items-center flex-wrap">
                    <span class="label-detail me-2">Thể Loại</span>
                    <div class="film-genre-list d-flex flex-wrap align-items-center">
                        @foreach (var g in Model.Genres ?? Enumerable.Empty<WebXemPhim.Models.Genre>())
                        {
                            <div class="film-genre-chip me-2 mb-1">@g.GenreName</div>
                        }
                    </div>
                </div>
                <div class="divider-line"></div>
                <div class="film-details-block">
                    <span class="label-detail">Tập mới nhất</span>
                    <span class="badge bg-info ms-2">@("Tập " + (Model.Episodes?.Max(e=>e.EpisodeNumber) ?? 1))</span>
                </div>
                <div class="divider-line"></div>
                <div class="film-details-block">
                    <span class="label-detail">Thông Tin Khác</span>
                    <span class="ms-2"><i class="fa fa-calendar-alt"></i> @Model.ReleaseYear</span>
                    <span class="ms-4"><i class="fa fa-film"></i> @((Model.EpsisodeCount ?? Model.Episodes?.Count) ?? 1) Tập</span>
                </div>
                <div class="divider-line"></div>
            </div>
        </div>

    <!-- Phần chọn tập -->
    <div class="card mt-4" style="background:#3333334A;">
        <div class="card-header fw-bold" style="background:transparent;color:#FFD800;">VIỆT SUB</div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                @foreach (var ep in Model.Episodes?.OrderByDescending(e => e.EpisodeNumber) ?? Enumerable.Empty<WebXemPhim.Models.Episode>())
                {
                    <a href="@Url.Action("Watch", "Episodes", new { id = ep.EpisodeId })" class="btn btn-dark episode-btn">
                        @ep.EpisodeNumber
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Nội dung phim -->
    <div class="card mt-4" style="background:#252525;">
        <div class="card-header fw-bold" style="color:#ffb930;">NỘI DUNG</div>
        <div class="card-body">
            <div id="descShort" class="movie-desc" style="color:#fff;">
                @(
                (Model.Description != null && Model.Description.Length > 280)
                ? Model.Description.Substring(0, 280) + "..."
                : Model.Description
            )
            </div>
            @if (Model.Description != null && Model.Description.Length > 280)
            {
                <div id="descMore" class="movie-desc d-none" style="color:#fff;">
                    @Model.Description
                </div>
                <a id="btnShowMore" class="text-warning" style="cursor:pointer;">Xem thêm...</a>
                <a id="btnShowLess" class="text-warning d-none" style="cursor:pointer;">Thu gọn</a>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var btnMore = document.getElementById('btnShowMore');
            var btnLess = document.getElementById('btnShowLess');
            var short = document.getElementById('descShort');
            var more = document.getElementById('descMore');
            if(btnMore && btnLess && short && more){
                btnMore.onclick = function () {
                    short.classList.add('d-none');
                    more.classList.remove('d-none');
                    btnMore.classList.add('d-none');
                    btnLess.classList.remove('d-none');
                };
                btnLess.onclick = function () {
                    short.classList.remove('d-none');
                    more.classList.add('d-none');
                    btnLess.classList.add('d-none');
                    btnMore.classList.remove('d-none');
                };
            }
        });
    </script>
}


