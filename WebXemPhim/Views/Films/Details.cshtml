@model WebXemPhim.Models.Film

@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-3">
        <img src="@Url.Content(Model.ThumbnailUrl)" class="img-fluid rounded" alt="@Model.Title" />
    </div>
    <div class="col-md-9">
        <h2 class="fw-bold text-warning">@Model.Title</h2>
        <div><b>Tên khác:</b> @Model.OriginalTitle</div>
        <div>
            <b>Thể loại:</b>
            @foreach (var genre in Model.Genres)
            {
                <span class="badge bg-secondary">@genre.GenreName</span>
            }
        </div>
        <div><b>Tập mới nhất:</b> </div>
        <div>
            <b>Thông tin khác:</b>
            <span><i class="fa fa-calendar"></i> @Model.ReleaseYear</span>
            <span><i class="fa fa-list-ol"></i> @Model.Episodes.Count tập</span>
        </div>
        <div>
            <b>Đánh giá:</b> <span class="text-warning fw-bold">@string.Format("{0:0.00}", Model.AverageRating)/5</span>
            <small> (@Model.Ratings.Count lượt)</small>
        </div>
        <a href="#" class="btn btn-warning mt-2">Xem Phim</a>
    </div>
</div>

<hr />

<div>
    <h5 class="text-info">Danh sách tập:</h5>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var ep in Model.Episodes.OrderByDescending(e => e.EpisodeNumber))
        {
            <a class="btn btn-outline-secondary" href="@Url.Action("Watch", "Episodes", new { id = ep.EpisodeId })">Tập @ep.EpisodeNumber</a>
        }

    </div>
</div>

<hr />

<div>
    <h5>Nội dung</h5>
    <div>@Model.Description</div>
</div>

<!-- Nếu có khu vực lịch chiếu, bình luận, đánh giá... bổ sung thêm tương tự -->