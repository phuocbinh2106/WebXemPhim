@model WebXemPhim.Models.Film

<div class="film-detail-container">
    <div class="detail-poster">
        <img src="@Model.ThumbnailUrl" alt="@Model.Title" />
    </div>
    <div class="detail-info">
        <h2>@Model.Title</h2>
        <div><b>Tên khác:</b> @Model.OriginalTitle</div>
        <div><b>Thể loại:</b> ... (render list nếu có)</div>
        <div><b>Mô tả/Tổng quan:</b> @Model.Description</div>
        <div><b>Số tập:</b> @Model.EpsisodeCount</div>
        <div><b>Lượt xem:</b> @Model.ViewCount</div>
        <div><b>Điểm đánh giá:</b> @Model.AverageRating</div>
        <!-- Thêm các thông tin khác nếu muốn -->
    </div>
</div>