@model WebXemPhim.Models.Film

@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-4">
            <img src="@Model.ThumbnailUrl" alt="@Model.Title"
                 class="img-fluid rounded shadow" style="object-fit:cover;max-width:360px;max-height:550px;" />
        </div>
        <div class="col-md-8 text-light">
            <h2 class="fw-bold" style="color:#FFB930">@Model.Title</h2>
            @if (!string.IsNullOrEmpty(Model.OriginalTitle))
            {
                <div class="mb-2 text-info">Tên gốc: @Model.OriginalTitle</div>
            }
            <!-- Thể loại -->
            <div class="mb-2">
                <b>Thể loại:</b>
                @if (Model.Genres != null)
                {
                    foreach (var genre in Model.Genres)
                    {
                        <span class="badge bg-secondary me-1">@genre.GenreName</span>
                    }
                }
            </div>
            <!-- Tập mới nhất -->
            <div class="mb-2">
                <span class="badge bg-info text-dark fs-6">
                    Tập mới nhất: <b>
                        @(Model.Episodes != null && Model.Episodes.Any()
                            ? Model.Episodes.Max(e => e.EpisodeNumber).ToString()
                            : "-")
                    </b>
                </span>
            </div>
            <!-- Thông tin khác -->
            <div class="mb-2 small">
                <span class="me-3"><i class="fa fa-calendar"></i> @Model.ReleaseYear</span>
                <span class="me-3"><i class="fa fa-list-ol"></i> Tổng số tập: @(Model.Episodes != null ? Model.Episodes.Count : 0)</span>
            </div>
        </div>
    </div>
    <!-- Danh sách tập -->
    <div class="bg-dark rounded mb-3 p-3">
        <h5 class="text-info mb-3 fw-bold">Danh sách tập</h5>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Episodes != null)
            {
                @foreach (var ep in Model.Episodes.OrderBy(e => e.EpisodeNumber))
                {
                    <a href="@Url.Action("Watch", "Episodes", new { id = ep.EpisodeId })"
                       class="btn btn-outline-warning btn-sm rounded-pill mb-2">
                        @ep.EpisodeNumber
                    </a>
                }
            }
        </div>
    </div>
</div>