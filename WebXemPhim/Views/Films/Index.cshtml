@model List<WebXemPhim.Models.Film>

@{
    ViewBag.Title = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <div class="d-flex justify-content-between mb-3 align-items-center">
        <h2 class="text-light fw-bold">📽 Phim Mới Cập Nhật</h2>
    </div>
    <div class="row gx-4 gy-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                <div class="movie-card-trending">
                    <!-- Badge số tập -->
                    <span class="badge episode-badge position-absolute">
                        Tập @(item.EpsisodeCount ?? 1)
                    </span>
                    <a href="@Url.Action("Details", "Films", new { id = item.FilmId })">
                        <img src="@item.ThumbnailUrl"
                             alt="@item.Title"
                             class="movie-film-img" />
                    </a>
                    <div class="card-body p-2">
                        <div class="movie-trending-info">
                            <div class="movie-trending-title">@item.Title</div>
                            <div class="small text-muted">
                                @item.ReleaseYear
                                @if (item.EpsisodeCount > 1)
                                {
                                    <span> • @item.EpsisodeCount tập</span>
                                }
                            </div>
                            <div class="movie-trending-sub">
                                @item.OriginalTitle
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .movie-film-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }
</style>
