@model List<WebXemPhim.Models.Film>
@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between mb-3 align-items-center">
    <h2 class="text-light fw-bold">@ViewBag.PageTitle</h2>
</div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4 g-4 movie-grid mb-4">
    @foreach (var film in Model)
    {
        <div class="col">
            <div class="movie-card-trending">
                <a href="@Url.Action("Details", "Films", new { id = film.FilmId })">
                    <img src="@film.ThumbnailUrl" alt="@film.Title" style="width:217.2px;height:260px;object-fit:cover;border-radius:10px;" />
                    <div class="episode-badge">
                        Tập @(film.EpsisodeCount ?? 1)
                    </div>
                </a>
                <div class="movie-trending-info">
                    <div class="movie-trending-title">@film.Title</div>
                    <div class="movie-trending-sub">@film.OriginalTitle</div>
                </div>
            </div>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <nav aria-label="Movie pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}

<style>
    .movie-film-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    .small-text {
        --bs-text-opacity: 1;
        color: #FFFFFF
    }
</style>
