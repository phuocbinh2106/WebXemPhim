@model IEnumerable<WebXemPhim.Models.Film>
@{
    ViewBag.Title = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mb-3">Danh Sách Phim</h2>
<a class="btn btn-success mb-3" href="@Url.Action("Create")">Thêm phim</a>
<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-4">
    @foreach (var film in Model)
    {
        <div class="col">
            <div class="card bg-dark text-light border-0 h-100 shadow">
                <a href="@Url.Action("Details", "Films", new { id = film.FilmId })">
                    <img src="@film.ThumbnailUrl" class="card-img-top rounded" alt="@film.Title"
                         style="object-fit:cover;aspect-ratio:3/4;max-height:250px;">
                </a>
                <div class="card-body p-2">
                    <h6 class="fw-bold mb-1">@film.Title</h6>
                    <div class="text-secondary small mb-1">@film.ReleaseYear</div>
                    <div>
                        @if (film.IsMovie)
                        {
                            <span class="badge bg-danger">Phim lẻ</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Phim bộ</span>
                        }
                        @if (film.IsCompleted)
                        {
                            <span class="badge bg-success">Hoàn thành</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Đang chiếu</span>
                        }
                    </div>
                    <a href="@Url.Action("Details", "Films", new { id = film.FilmId })" class="btn btn-outline-light btn-sm mt-2">Chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.OriginalTitle)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ReleaseYear)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsMovie)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsCompleted)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EpsisodeCount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ThumbnailUrl)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UpdateAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ViewCount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AverageRating)
        </th>
        <th></th>
    </tr>

        .film-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px #0005;
        }

    .card-title {
        font-weight: 500;
        color: #fff;
    }
</style>
<!-- Nhớ import Bootstrap và Bootstrap Icons vào layout -->
