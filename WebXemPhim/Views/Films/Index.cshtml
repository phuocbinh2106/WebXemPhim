@model IEnumerable<WebXemPhim.Models.Film>
@{
    ViewBag.Title = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4">
    <div class="d-flex justify-content-between mb-3 align-items-center">
        <h2 class="text-light fw-bold">@ViewBag.PageTitle</h2>


    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="card h-100 bg-dark text-light shadow film-card border-0">

                    <div class="position-relative poster-wrapper">
                        <a href="@Url.Action("Details", "Films", new { id = item.FilmId })">
                            <img src="@item.ThumbnailUrl"
                                 alt="@item.Title"
                                 class="card-img-top img-fluid poster-img">

                            <!-- Badge loại phim -->
                            <span class="badge position-absolute top-0 start-0 m-1
                                @(item.IsMovie ? "bg-danger" : "bg-primary")">
                                @(item.IsMovie ? "Phim lẻ" : "Phim bộ")
                            </span>

                            <!-- Badge trạng thái -->
                            <span class="badge position-absolute top-0 end-0 m-1
                                @(item.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                @(item.IsCompleted ? "Trọn bộ" : "Đang chiếu")
                            </span>

                            <!-- Hiệu ứng overlay khi hover -->
                            <div class="hover-overlay">
                                <i class="bi bi-play-circle-fill play-icon"></i>
                            </div>
                        </a>
                    </div>

                    <div class="card-body p-2">
                        <h6 class="card-title mb-1 text-truncate" title="@item.Title">@item.Title</h6>

                        <div class="small text-muted">
                            @item.ReleaseYear
                            @if (item.EpsisodeCount > 1)
                            {
                                <span> • @item.EpsisodeCount tập</span>
                            }
                        </div>


                    </div>

                </div>
            </div>
        }
    </div>
</div>


<style>
    body {
        background: #0a0e21 !important;
    }

    .film-card {
        border-radius: 0.8rem;
        transition: .25s ease;
    }

        .film-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 30px #0007;
        }

    .poster-img {
        height: 260px;
        object-fit: cover;
        border-radius: .8rem .8rem 0 0;
    }

    /* Overlay khi hover */
    .poster-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: .8rem .8rem 0 0;
    }

    .hover-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.45);
        opacity: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s ease;
    }

    .poster-wrapper:hover .hover-overlay {
        opacity: 1;
    }
</style>
