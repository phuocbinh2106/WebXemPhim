@model IEnumerable<WebXemPhim.Models.Film>

@{
    ViewBag.Title = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-3 align-items-center">
        <h2 class="text-light">Phim Mới</h2>
        @Html.ActionLink("Thêm phim", "Create", null, new { @class = "btn btn-success" })
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="card h-100 bg-dark text-light shadow-sm film-card">
                    <div class="position-relative">
                        <a href="@Url.Action("Details", "Films", new { id = item.FilmId })">
                            <img src="@item.ThumbnailUrl" alt="@item.Title" class="card-img-top img-fluid" style="height:260px; object-fit:cover;">
                            @if ((bool)item.IsMovie)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-1">Phim lẻ</span>
                            }
                            else
                            {
                                <span class="badge bg-primary position-absolute top-0 start-0 m-1">Phim bộ</span>
                            }
                            @if ((bool)item.IsCompleted)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-1">Trọn bộ</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-1">Đang chiếu</span>
                            }
                        </a>
                    </div>
                    <div class="card-body p-2">
                        <h6 class="card-title mb-1 text-truncate" title="@item.Title">@item.Title</h6>
                        <div class="small text-muted">
                            @item.ReleaseYear @if (item.EpsisodeCount > 1)
                            {<span>- @item.EpsisodeCount tập</span>}
                        </div>
                        <div class="mt-1">
                            <span class="me-2"><i class="bi bi-eye"></i> @item.ViewCount</span>
                            <span class="text-warning"><i class="bi bi-star-fill"></i> @item.AverageRating</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-2">
                        <a href="@Url.Action("Edit", "Films", new { id = item.FilmId })" class="btn btn-sm btn-light me-1">Sửa</a>
                        <a href="@Url.Action("Details", "Films", new { id = item.FilmId })" class="btn btn-sm btn-primary me-1">Chi tiết</a>
                        <a href="@Url.Action("Delete", "Films", new { id = item.FilmId })" class="btn btn-sm btn-danger">Xoá</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0a0e21;
    }

    .film-card {
        transition: transform .15s, box-shadow .15s;
        border-radius: 0.7rem;
    }

        .film-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px #0005;
        }

    .card-title {
        font-weight: 500;
        color: #fff;
    }
</style>
<!-- Nhớ import Bootstrap và Bootstrap Icons vào layout -->
