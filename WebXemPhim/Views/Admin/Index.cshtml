@model WebXemPhim.ViewModel.AdminIndexViewModel

@{
    ViewBag.Title = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-3 align-items-center">
        <h2 class="text-light">Phim Mới</h2>
        <div>
            <a href="/Films/Create" class="btn btn-success me-2">Thêm phim</a>
            <a href="/Episodes/Create" class="btn btn-primary me-2">Thêm tập phim</a>
            <a href="/Genres/Create" class="btn btn-info">Thêm thể loại</a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var film in Model.Films)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="card h-100 bg-dark text-light shadow-sm film-card">
                    <div class="position-relative">
                        <a href="@Url.Action("Details", "Films", new { id = film.FilmId })">
                            <img src="@film.ThumbnailUrl" alt="@film.Title" class="card-img-top img-fluid" style="height:260px; object-fit:cover;">
                            @if (film.IsMovie)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-1">Phim lẻ</span>
                            }
                            else
                            {
                                <span class="badge bg-primary position-absolute top-0 start-0 m-1">Phim bộ</span>
                            }
                            @if (film.IsCompleted)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-1">Trọn bộ</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-1">Đang chiếu</span>
                            }
                        </a>
                    </div>
                    <div class="card-body p-2">
                        <h6 class="card-title mb-1 text-truncate" title="@film.Title">@film.Title</h6>
                        <div class="small text-muted">
                            @film.ReleaseYear
                            @if (film.EpsisodeCount != null && film.EpsisodeCount > 1)
                            {
                                <span>- @film.EpsisodeCount tập</span>
                            }
                        </div>
                        @if (film.Genres != null && film.Genres.Any())
                        {
                            <div class="mt-1">
                                <span class="text-primary">
                                    <i class="bi bi-tags"></i>
                                    @string.Join(", ", film.Genres.Select(g => g.GenreName))
                                </span>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent border-0 p-2">
                        <a href="@Url.Action("Edit", "Films", new { id = film.FilmId })" class="btn btn-sm btn-light me-1">Sửa</a>
                        <a href="@Url.Action("Details", "Films", new { id = film.FilmId })" class="btn btn-sm btn-primary me-1">Chi tiết</a>
                        <a href="@Url.Action("Delete", "Films", new { id = film.FilmId })" class="btn btn-sm btn-danger"
                           onclick="return confirm('Bạn có chắc muốn xoá không?');">Xóa</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0a0e21;
    }

    .film-card {
        transition: transform .15s, box-shadow .15s;
        border-radius: 0.7rem;
    }

        .film-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px #0005;
        }

    .card-title {
        font-weight: 500;
        color: #fff;
    }
</style>
