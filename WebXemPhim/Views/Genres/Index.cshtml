@model IEnumerable<WebXemPhim.Models.Genre>
@{
    ViewBag.Title = "Thể loại phim";
    bool isAdmin = Session["Role"] != null && Session["Role"].ToString().ToLower() == "admin";
}
<div class="container py-4" style="font-family:'Segoe UI',Arial,sans-serif;">
    <div class="bg-dark rounded-4 shadow-lg p-4 mx-auto" style="max-width:720px; color:#f5f6fa;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0" style="color:#FFD600;">Thể Loại Phim</h3>
            @if (isAdmin)
            {
                <a href="@Url.Action("Create")" class="btn btn-info fw-bold px-4">+ Thêm mới</a>
            }
        </div>
        <div class="table-responsive rounded-3">
            <table class="table table-dark table-striped align-middle mb-0" style="border-radius:10px;">
                <thead>
                    <tr class="text-secondary">
                        <th style="width:45%;">Tên thể loại</th>
                        <th class="text-center" style="width:55%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var genre in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-light" style="font-size:1.1rem;">@genre.GenreName</td>
                            <td class="text-center">
                                @if (isAdmin)
                                {
                                    <a href="@Url.Action("Edit", new { id = genre.GenreId })" class="btn btn-sm btn-warning mx-1 fw-bold">Sửa</a>
                                    <a href="@Url.Action("Delete", new { id = genre.GenreId })" class="btn btn-sm btn-danger mx-1">Xóa</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
