@model List<WebXemPhim.Models.WatchHistory>
@{
    ViewBag.Title = "Lịch sử xem";
}
<div class="container d-flex flex-column align-items-center" style="min-height:70vh;font-family:'Segoe UI',Arial,sans-serif;">
    <div class="card shadow-lg p-4 rounded w-100" style="max-width:600px; background:#1f2833; color:#FFFFFF;">
        <h3 class="mb-4 text-center" style="color:#66fcf1; font-family:inherit;">Lịch sử xem phim</h3>
        <table class="table table-dark table-striped rounded" style="font-family:inherit;">
            <thead>
                <tr>
                    <th>Phim</th>
                    <th>Tập</th>
                    <th>Thời gian xem</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td>@h.Episode.Film.Title</td>
                        <td>@h.Episode.EpisodeNumber</td>
                        <td>@h.WatchedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (h.WatchHistoryId > 0)
                            {
                                <a href="@Url.Action("Details", "Films", new { id = h.Episode.FilmId })"
                                   class="btn btn-warning btn-sm px-3 fw-bold">Chi tiết</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
