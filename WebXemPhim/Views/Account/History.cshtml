@model List<WebXemPhim.Models.WatchHistory>
@{
    ViewBag.Title = "Lịch sử xem";
}
<div class="container d-flex flex-column align-items-center" style="min-height:70vh;">
    <div class="card shadow-lg p-4 rounded w-100" style="max-width:600px; background:#1f2833; color:#fff;">
        <h3 class="mb-4 text-center" style="color:#66fcf1;">Lịch sử xem phim</h3>
        <table class="table table-dark table-striped rounded">
            <thead>
                <tr>
                    <th>Phim</th>
                    <th>Thời gian xem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td>@h.EpisodeId</td>
                        <td>@h.WatchedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
