@{
    ViewBag.Title = "Đăng nhập";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="card shadow-lg p-4 rounded" style="max-width:400px; width:100%;background:#1f2833; color:#fff;">
        <h2 class="mb-4 text-center" style="color:#66fcf1;">Đăng nhập</h2>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="Username" class="form-label">Tên đăng nhập</label>
                <input type="text" name="Username" class="form-control" placeholder="Tên đăng nhập" style="background:#0b0c10; color:#fff;" />
            </div>
            <div class="mb-3">
                <label for="Password" class="form-label">Mật khẩu</label>
                <input type="password" name="Password" class="form-control" placeholder="Mật khẩu" style="background:#0b0c10; color:#fff;" />
            </div>
            <button type="submit" class="btn btn-info w-100 mb-2" style="color:#0b0c10; font-weight:600;">Đăng nhập</button>
        }
        <!-- THÔNG BÁO LỖI ĐẶT NGOÀI BLOCK FORM -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-2 text-center">@ViewBag.Error</div>
        }
        <div class="text-center mt-3">
            <span>Chưa có tài khoản?</span>
            <a href="@Url.Action("Register", "Account")" class="btn btn-link" style="color:#66fcf1;font-weight:600;">Đăng ký ngay</a>
        </div>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <!-- Username, Password -->
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" id="rememberMe" name="RememberMe" />
                <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
            </div>
        }

    </div>
</div>
