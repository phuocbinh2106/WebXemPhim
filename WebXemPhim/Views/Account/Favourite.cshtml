@model List<WebXemPhim.Models.Favourite>
@{
    ViewBag.Title = "Phim yêu thích";
}
<div class="container d-flex flex-column align-items-center" style="min-height:70vh;">
    <div class="card shadow-lg p-4 rounded w-100" style="max-width:600px; background:#1f2833; color:#fff;">
        <h3 class="mb-4 text-center" style="color:#66fcf1;">Phim yêu thích của bạn</h3>
        <ul class="list-group list-group-flush">
            @foreach (var fav in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center" style="background:#232830; color:#fff; border: none;">
                    @fav.FilmId
                    <span class="badge bg-info text-dark">Yêu thích</span>
                </li>
            }
        </ul>
    </div>
</div>
