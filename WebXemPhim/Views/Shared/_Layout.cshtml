@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Web Xem Phim 3D</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome cho icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #1C1C1C !important;
            color: #fff;
            font-family: 'Segoe UI', 'Montserrat', Arial, sans-serif;
        }

        .navbar {
            background-color: #1C1C1C;
        }

        /* Dòng dưới: căn 3 phần đều nhau, search giữa. */
        .container-fluid.d-flex.align-items-center {
            display: flex !important;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding-left: 66px;
            padding-right: 66px;
            gap: 12px;
        }

        .navbar-brand {
            color: #FFB930 !important;
            font-weight: bold;
            font-size: 2em;
            letter-spacing: 2px;
            margin-right: 42px;
            min-width: 220px;
        }

        .modern-search-bar {
            width: 320px;
            max-width: 520px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #191919;
            border-radius: 20px;
            border: 1.5px solid #323435;
            padding-left: 42px;
            height: 45px;
            margin: 0 30px;
            flex: 1 1 420px;
        }

            .modern-search-bar input {
                width: 100%;
                background: transparent;
                border: none;
                color: #eaeaea;
                font-size: 1.15em;
                padding: 0 16px 0 0;
                outline: none;
                height: 44px;
                border-radius: 0 26px 26px 0;
            }

                .modern-search-bar input::placeholder {
                    color: #a5a5a5;
                    font-weight: 500;
                    letter-spacing: 0.6px;
                    opacity: 1;
                }

        .search-icon {
            position: absolute;
            left: 14px;
            top: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            color: #eaeaea;
            font-size: 1.22em;
            opacity: 0.8;
            pointer-events: none;
        }

        .navbar-nav.ms-auto.mb-2.mb-lg-0 {
            margin-left: 0 !important;
            margin-right: 0 !important;
            gap: 0;
        }

        .nav-link {
            color: #c5c6c7 !important;
            margin-right: 0;
        }

            .nav-link:hover {
                color: #FFD800 !important;
            }

        .fa-user-circle, .fa-user {
            color: #FFD800 !important;
        }

        .nav-item.dropdown {
            display: flex;
            align-items: center;
        }

        .dropdown-menu.user-menu {
            background: #18191a !important;
            color: #fff !important;
            border: none;
        }

            .dropdown-menu.user-menu .dropdown-item,
            .dropdown-menu.user-menu .fw-bold {
                color: #fff !important;
            }

                .dropdown-menu.user-menu .dropdown-item.text-danger {
                    color: #ff6961 !important;
                }

            .dropdown-menu.user-menu i {
                color: #FFD800 !important;
            }
        /* MENU NGANG */
        .main-menu {
            width: 100%;
            background: #1F2021;
            box-shadow: 0 1px 7px rgba(0,0,0,0.09);
            margin-bottom: 0;
        }

            .main-menu ul {
                list-style: none;
                display: flex;
                gap: 16px;
                justify-content: flex-start;
                align-items: center;
                padding: 0 0 0 100px; /* chỉnh padding này ngang bằng với logo bên trên */
                margin: 0;
                min-height: 45px;
            }

            .main-menu li {
                display: flex;
                align-items: center;
            }

                .main-menu li a {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: #ececec;
                    font-size: 1.07em;
                    font-weight: 500;
                    padding: 8px 10px 8px 10px;
                    text-decoration: none;
                    border-radius: 7px;
                    transition: background 0.12s, color 0.12s;
                }

                    .main-menu li a:hover, .main-menu li a:active {
                        background: #232426;
                        color: #FFD800;
                    }

        .movie-card {
            background-color: #1f2833;
            border: none;
            border-radius: 10px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .movie-card:hover {
                transform: scale(1.03);
            }

        .movie-title {
            font-weight: 600;
            color: #fff;
            text-align: center;
            margin-top: 8px;
        }

        footer {
            background-color: #1f2833;
            color: #c5c6c7;
            text-align: center;
            padding: 20px 0;
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <!-- NAVBAR HEADER -->
    <nav class="navbar navbar-expand-lg navbar-dark py-2">
        <div class="container-fluid d-flex align-items-center">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">🎬HoatHinh3D</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <form class="modern-search-bar">
                <h3 class="search-icon"><i class="fa fa-search"></i></h3>
                <input type="text" placeholder="Search..." />
            </form>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item dropdown">
                    @if (Session["UserId"] != null)
                    {
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @{
                                var avatar = Session["Avatar"] != null
                                    ? Session["Avatar"].ToString()
                                    : null;
                            }
                            @if (!string.IsNullOrEmpty(avatar))
                            {
                                <img src="@Url.Content(avatar)" alt="Avatar" class="rounded-circle me-2" width="32" height="32" />
                            }
                            else
                            {
                                <i class="fa fa-user-circle me-2" style="font-size: 1.8rem; color: #FFD800;"></i>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow user-menu" aria-labelledby="profileDropdown" style="min-width:220px;">
                            <li class="px-3 py-2">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(avatar))
                                    {
                                        <img src="@Url.Content(avatar)" alt="Avatar" class="rounded-circle me-2" width="48" height="48" />
                                    }
                                    else
                                    {
                                        <i class="fa fa-user-circle me-2" style="font-size: 2.5rem; color: #FFD800;"></i>
                                    }
                                    <span class="fw-bold" style="font-size:1.1rem">@Session["Nickname"]</span>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                    <i class="fa fa-user me-2"></i>Thông tin cá nhân
                                </a>
                            </li>
                            @if (Session["Role"] != null && Session["Role"].ToString().ToLower() == "admin")
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Index", "Films")">
                                        <i class="fa fa-film me-2"></i>Quản lý phim
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                    <i class="fa fa-sign-out-alt me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <a class="nav-link" href="@Url.Action("Login", "Account")">
                            <i class="fa fa-user-circle" style="font-size: 1.8rem; color: #FFD800;"></i>
                        </a>
                    }
                </li>
            </ul>
        </div>
    </nav>
    <!-- MENU NGANG -->
    <nav class="main-menu">
        <ul>
            <li><a href="/"><i class="fas fa-home"></i> Trang chủ</a></li>
            <li><a href="#">Thể Loại <i class="fas fa-chevron-down" style="font-size:0.9em;"></i></a></li>
            <li><a href="#">Phim Lẻ</a></li>
            <li><a href="#">Đang Chiếu <i class="fas fa-sync-alt"></i></a></li>
            <li><a href="#">Lịch Chiếu <i class="fas fa-calendar-alt"></i></a></li>
            <li><a href="#"><i class="fas fa-check-circle"></i> Hoàn Thành</a></li>
            <li><a href="#"><i class="fas fa-trophy"></i> Top 10 HH3D</a></li>
            <li><a href="#"><i class="fas fa-thumbs-up"></i> Đánh Giá Cao</a></li>
        </ul>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer>
        <p>&copy; @DateTime.Now.Year - HoatHinh3D | Thiết kế bởi LinhDepZaiSo1VN 🎥</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
