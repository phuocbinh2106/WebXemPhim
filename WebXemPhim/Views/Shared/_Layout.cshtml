@{ Layout = null; }

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Web Xem Phim 3D</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome cho icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Content/MyStyle.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- NAVBAR HEADER -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">🎬HoatHinh3D</a>
            <form class="modern-search-bar" method="get" action="@Url.Action("Search", "Films")">
                <span class="search-icon"><i class="fa fa-search"></i></span>
                <input type="text" name="query" placeholder="Tìm Kiếm ..." />
            </form>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <!-- Icon yêu thích -->
                <li class="nav-item icon-header">
                    <a class="nav-link" href="@Url.Action("Index", "Favourites")" title="Phim yêu thích">
                        <i class="fa fa-heart" style="color:#DA0037; font-size:1.5rem;"></i>
                    </a>
                </li>
                <!-- Icon lịch sử xem -->
                <li class="nav-item icon-header">
                    <a class="nav-link" href="@Url.Action("History", "Account")" title="Lịch sử xem">
                        <i class="fa fa-clock" style="color:#0099FF; font-size:1.5rem;"></i>
                    </a>
                </li>
                <li class="nav-item dropdown icon-header">
                    @if (Session["UserId"] != null)
                    {
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @{
                                var avatar = Session["Avatar"] != null
                                    ? Session["Avatar"].ToString()
                                    : null;
                            }
                            @if (!string.IsNullOrEmpty(avatar))
                            {
                                <img src="@Url.Content(avatar)" alt="Avatar" class="rounded-circle me-2" width="32" height="32" />
                            }
                            else
                            {
                                <i class="fa fa-user-circle me-2" style="font-size: 1.8rem; color: #FFD800;"></i>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow user-menu" aria-labelledby="profileDropdown" style="min-width:220px;">
                            <li class="px-3 py-2">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(avatar))
                                    {
                                        <img src="@Url.Content(avatar)" alt="Avatar" class="rounded-circle me-2" width="48" height="48" />
                                    }
                                    else
                                    {
                                        <i class="fa fa-user-circle me-2" style="font-size: 2.5rem; color: #FFD800;"></i>
                                    }
                                    <span class="fw-bold" style="font-size:1.1rem">@Session["Nickname"]</span>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                    <i class="fa fa-user me-2"></i>Thông tin cá nhân
                                </a>
                            </li>
                            @if (Session["Role"] != null && Session["Role"].ToString().ToLower() == "admin")
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Index", "Admin")">
                                        <i class="fa fa-film me-2"></i>Quản lý phim
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                    <i class="fa fa-sign-out-alt me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <a class="nav-link" href="@Url.Action("Login", "Account")">
                            <i class="fa fa-user-circle" style="font-size: 1.8rem; color: #FFD800;"></i>
                        </a>
                    }
                </li>
            </ul>
        </div>
    </nav>
    <!-- MENU NGANG -->
    <nav class="navbar navbar-expand-lg" style="background:#1F2021;">
        <div class="container">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">


                <li class="nav-item">
                    <a class="nav-link" href="/"><i class="fas fa-home"></i> Trang chủ</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="genreDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        Thể Loại
                    </a>
                    @Html.Action("GenreDropdown", "Genres")
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Films/Filter?isMovie=true">Phim Lẻ</a>
                </li>

                <li class="nav-item"><a class="nav-link" href="/Films?type=series">Phim Bộ</a></li>
                <li class="nav-item">
                    <a class="nav-link" href="/Films/Filter?isOngoing=true">Đang Chiếu</a>
                </li>

            </ul>
        </div>
    </nav>


    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer>
        <p>&copy; @DateTime.Now.Year - HoatHinh3D | Thiết kế bởi BLND 🎥</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
