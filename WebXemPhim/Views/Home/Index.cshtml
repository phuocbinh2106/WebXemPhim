@{
    ViewBag.Title = "Trang Chủ - HoatHinh3D";
}
<style>
    body {
        background-color: #1a1a1a;
        color: #f5f5f5;
        font-family: 'Arial', sans-serif;
    }

    .navbar {
        background-color: #111;
    }

    .navbar-brand {
        color: #fff !important;
        font-weight: bold;
    }

    .movie-grid {
        justify-content: center;
    }

    .card.movie-card-item {
        background-color: #1a1a1a;
        border: none;
        overflow: hidden;
    }
    .card-text {
        color: #aaa;
        font-size: 0.9em;
    }

    .episode-badge {
        position: absolute;
        top: 5px;
        left: 5px;
        background-color: #e50914;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 0.85em;
        z-index: 10;
    }

    .card-img-top.movie-poster {
        height: 300px;
        object-fit: cover;
    }

    .btn-warning-custom {
        background-color: #ffc107;
        color: #1a1a1a;
        font-weight: bold;
        border: none;
        padding: 10px 30px;
        margin-top: 20px;
    }

    .trending-row {
        display: flex;
        gap: 24px;
        justify-content: flex-start;
        flex-wrap: wrap;
        padding: 18px 0 0 0;
    }

    .movie-card-trending {
        position: relative;
        width: 285px;
        height: 380px;
        border-radius: 10px;
        overflow: hidden;
        background: #222;
        box-shadow: 0 4px 24px rgba(0,0,0,0.14);
    }

    .movie-trending-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    /* Overlay ở phía dưới hình, mang màu nền tối */
    .movie-trending-info {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(25,25,25,0.93) 88%, rgba(25,25,25,0.05) 99%);
        padding: 22px 22px 18px 22px;
        z-index: 2;
    }

    /* Tên phim */
    .movie-trending-title {
        color: #fff;
        font-size: 1.19em;
        font-weight: 700;
        margin-bottom: 4px;
        letter-spacing: 0.2px;
        text-shadow: 0 1px 8px rgba(0,0,0,0.12);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        display: block;
    }
    /* Phụ đề */
    .movie-trending-sub {
        color: #fff; /* Đổi sang màu trắng */
        font-size: 0.93em; /* Nhỏ hơn */
        font-weight: 400; /* Chữ mỏng hơn */
        opacity: 0.85; /* Nhạt vừa phải để nổi phần trên */
        letter-spacing: 0.08px;
        text-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }

    .trending-title {
        font-size: 1.05em; /* Nhỏ hơn mặc định */
        font-weight: bold;
        letter-spacing: 0.5px;
        background: linear-gradient(90deg, #ffc107 10%, #fd2d87 90%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-fill-color: transparent;
        margin-bottom: 12px;
        display: inline-block;
        line-height: 1.18;
    }

    .trending-title-line {
        width: 100%;
        max-width: 1273px;
        height: 1.5px;
        margin-top: 4px;
        margin-bottom: 16px;
        border-radius: 1.5px;
        background: linear-gradient(90deg, #ffc107 0px, #fd2d87 70px, #fd2d87 140px, #232328 141px, /* Phần sau của line */
        #232328 100% );
        box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    }
</style>
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
