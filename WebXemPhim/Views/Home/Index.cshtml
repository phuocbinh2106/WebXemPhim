@using System.Linq

@model IEnumerable<WebXemPhim.Models.Film>
@{
    ViewBag.Title = "Trang Chủ - HoatHinh3D";
}
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
<main class="container py-5">

    <h3 class="trending-title"><i class="fas fa-fire"></i> ĐANG THỊNH HÀNH</h3>
    <div class="trending-title-line"></div>
    <div class="swiper trending-slider">
        <div class="swiper-wrapper">
            @foreach (var film in Model)
            {
                <div class="swiper-slide">
                    <div class="card bg-dark text-light h-100 shadow border-0 position-relative" style="overflow:hidden">
                        <a href="@Url.Action("Details", "Films", new { id = film.FilmId })">
                            <img src="@film.ThumbnailUrl" alt="@film.Title" class="card-img-top" />
                        </a>
                        <div class="card-body px-3 pb-2 pt-3" style="background:linear-gradient(180deg,transparent 60%,rgba(15,15,15,.9) 100%);margin-top:-70px;">
                            <div class="card-title film-title">@film.Title</div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>

    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper('.trending-slider', {
            slidesPerView: 4,
            spaceBetween: 24,
            loop: true,
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                1200: { slidesPerView: 4 },
                900: { slidesPerView: 3 },
                600: { slidesPerView: 2 },
                0: { slidesPerView: 1 }
            }
        });
    </script>

    <h2 class="mt-5 mb-3 trending-title">MỚI CẬP NHẬT</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4 movie-grid mb-5">
        @foreach (var film in Model)
        {
            <div class="col">
                <div class="movie-card-trending">
                    <a href="@Url.Action("Details", "Films", new { id = film.FilmId })">
                        <img src="@film.ThumbnailUrl" alt="@film.Title" class="movie-trending-img" />
                        @* Badge số tập nếu có *@
                        @if (film.Episodes != null && film.Episodes.Any())
                        {
                            <div class="episode-badge">
                                Tập @film.Episodes.Max(e => e.EpisodeNumber)
                            </div>
                        }
                    </a>
                    <div class="movie-trending-info">
                        <div class="movie-trending-title">@film.Title</div>
                        <div class="movie-trending-sub">
                            @film.OriginalTitle
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count() >= 10)
    {
        <div style="text-align: center; margin-top: 20px;">
            <a href="@Url.Action("Index", "Films")"
               style="padding: 10px 20px; background: #ff4444; color: white; text-decoration: none; border-radius: 6px; font-size: 16px;">
                Xem thêm
            </a>
        </div>
    }
</main>