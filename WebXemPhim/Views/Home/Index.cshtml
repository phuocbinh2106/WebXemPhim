@using System.Linq
@model IEnumerable<WebXemPhim.Models.Film>
@{
    ViewBag.Title = "Trang Chủ - HoatHinh3D";
}
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
<main class="container py-5">

    <h3 class="trending-title"><i class="fas fa-fire"></i> ĐANG THỊNH HÀNH</h3>
    <div class="trending-title-line"></div>

    <div class="swiper trending-slider">
        <div class="swiper-wrapper">
            @foreach (var banner in new[]{
                new { Img="~/Upload/Banner/giathien.jpg", Title="Già Thiên", Sub="Zhe Tian"},
                new { Img="~/Upload/Banner/thonphetinhkhong.jpg", Title="Thôn Phệ Tinh Không", Sub="Swallowed Star"},
                new { Img="~/Upload/Banner/dauladailuc2.jpg", Title="Đấu La Đại Lục 2: Tuyệt Thế Đường Môn", Sub="Douluo Dalu II: Jue Shi Tang Men"},
                new { Img="~/Upload/Banner/thananvuongtoa.jpg", Title="Thần Ấn Vương Tọa", Sub="Throne Of Seal"},
                new { Img="~/Upload/Banner/dauphathuongkhung.jpg", Title="Đấu Phá Thương Khung", Sub="Fights Break Sphere S"},
                new { Img="~/Upload/Banner/phamnhan.jpg", Title="Phàm Nhân Tu Tiên", Sub="Fanren Xiu Xian Chuan S3"},
                new { Img="~/Upload/Banner/tiennghich.png", Title="Tiên Nghịch", Sub="Xian Ni"},
                new { Img="~/Upload/Banner/mucthanky.jpg", Title="Mục Thần Ký", Sub="Mu Shen Ji"},
                new { Img="~/Upload/Banner/vudongcankhon.webp", Title="Vũ Động Càn Khôn", Sub="Wu Dong Qian Kun"},
                new { Img="~/Upload/Banner/thegioihoanmy.jpg", Title="Thế Giới Hoàn Mỹ", Sub="Perfect World"}
            })
            {
                <div class="swiper-slide">
                    <div class="movie-card-trending">
                        <img src="@Url.Content(banner.Img)" alt="@banner.Title" class="movie-trending-img" />
                        <div class="movie-trending-info">
                            <div class="movie-trending-title">@banner.Title</div>
                            <div class="movie-trending-sub">@banner.Sub</div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>

    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper('.trending-slider', {
            slidesPerView: 4,
            spaceBetween: 24,
            loop: true,
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                1200: { slidesPerView: 4 },
                900: { slidesPerView: 3 },
                600: { slidesPerView: 2 },
                0: { slidesPerView: 1 }
            }
        });
    </script>

    <!-- Grid MỚI CẬP NHẬT kiểu trending -->

    <h2 class="mt-5 mb-3 trending-title">MỚI CẬP NHẬT</h2>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4 movie-grid mb-5">
        @foreach (var film in Model)
        {
            <div class="col">
                <div class="movie-card-trending">
                    <a href="@Url.Action("Details", "Films", new { id = film.FilmId })">
                        <img src="@film.ThumbnailUrl" alt="@film.Title" class="movie-trending-img" />
                        @* Badge số tập nếu có *@
                        @if (film.Episodes != null && film.Episodes.Any())
                        {
                            <div class="episode-badge">
                                Tập @film.Episodes.Max(e => e.EpisodeNumber)
                            </div>
                        }
                    </a>
                    <div class="movie-trending-info">
                        <div class="movie-trending-title">@film.Title</div>
                        <div class="movie-trending-sub">
                            @film.OriginalTitle
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count() >= 8)
    {
        <div style="text-align: center; margin-top: 20px;">
            <a href="@Url.Action("Index", "Films")"
               style="padding: 10px 20px; background: #ff4444; color: white; text-decoration: none; border-radius: 6px; font-size: 16px;">
                Xem thêm
            </a>
        </div>
    }
</main>
