@{
    ViewBag.Title = "Trang Chủ - HoatHinh3D";
}

<style>
    body {
        background-color: #1a1a1a; 
        color: #f5f5f5;
        font-family: 'Arial', sans-serif;
    }

    .navbar {
        background-color: #111; 
    }

    .navbar-brand {
        color: #fff !important;
        font-weight: bold;
    }

    .movie-grid {
        justify-content: center; 
    }

    .card.movie-card-item {
        background-color: #1a1a1a; 
        border: none;
        overflow: hidden;
        position: relative;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .card.movie-card-item:hover {
            transform: scale(1.03); 
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
        }

    .movie-card-item img {
        height: 350px;
        object-fit: cover;
        border-radius: 4px;
    }

    .card-body {
        padding: 10px 0 0 0 !important;
        text-align: left;
    }

    .card-title {
        font-size: 1.1em;
        margin-bottom: 2px;
        color: #fff;
    }

    .card-text {
        color: #aaa;
        font-size: 0.9em;
    }

    .rating-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: #000000e0;
        color: #ffc107; 
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 0.9em;
    }

    .rank-badge {
        position: absolute;
        top: 10px;
        left: 0px; 
        background-color: #ffc107; 
        color: #1a1a1a;
        padding: 5px 8px;
        border-radius: 0 4px 4px 0;
        font-weight: bold;
        font-size: 1.1em;
    }

    .btn-warning-custom {
        background-color: #ffc107; 
        color: #1a1a1a;
        font-weight: bold;
        border: none;
        padding: 10px 30px;
        margin-top: 20px;
    }
</style>

<header class="navbar navbar-expand-lg navbar-dark sticky-top" style="background-color: #111;">
    <div class="container">
        <a class="navbar-brand" href="#">HoatHinh3D</a>

        <div class="d-flex me-auto ms-5">
            <input class="form-control me-2" type="search" placeholder="Tìm kiếm" aria-label="Search" style="width: 200px; background-color: #333; color: white; border: none;">
            <button class="btn btn-primary" type="submit" style="background-color: #007bff; border-color: #007bff;">Tìm</button>
        </div>

        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link active" href="#">Trang Chủ</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Phim Mới</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Thể Loại</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Liên Hệ</a></li>
            </ul>
        </div>
    </div>
</header>

<main class="container py-5">

    <h2 class="text-center mb-4" style="color: #ffc107;">
        <i class="fas fa-fire"></i> <b>ĐANG THỊNH HÀNH</b>
    </h2>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 movie-grid justify-content-center">

        <div class="col" style="max-width: 250px;">
            <div class="card h-100 movie-card-item">
                <img src="/Banner/daupha.jpg" class="card-img-top" alt="Đấu Phá Thương Khung">
                <div class="rank-badge">1</div>
                <div class="rating-badge">4.0</div>
                <div class="card-body">
                    <h5 class="card-title text-truncate">Đấu Phá Thương Khung</h5>
                    <p class="card-text text-muted">Fights Break Sphere S</p>
                </div>
            </div>
        </div>

        <div class="col" style="max-width: 250px;">
            <div class="card h-100 movie-card-item">
                <img src="/Banner/tiennghich.jpg" class="card-img-top" alt="Tiên Nghịch">
                <div class="rank-badge">2</div>
                <div class="rating-badge">4.5</div>
                <div class="card-body">
                    <h5 class="card-title text-truncate">Tiên Nghịch</h5>
                    <p class="card-text text-muted">Xian Ni</p>
                </div>
            </div>
        </div>

        <div class="col" style="max-width: 250px;">
            <div class="card h-100 movie-card-item">
                <img src="/Banner/muthanky.jpg" class="card-img-top" alt="Mục Thần Ký">
                <div class="rank-badge">3</div>
                <div class="rating-badge">4.6</div>
                <div class="card-body">
                    <h5 class="card-title text-truncate">Mục Thần Ký</h5>
                    <p class="card-text text-muted">Mu Shen Ji</p>
                </div>
            </div>
        </div>

        <div class="col" style="max-width: 250px;">
            <div class="card h-100 movie-card-item">
                <img src="/Banner/phamnhan.jpg" class="card-img-top" alt="Phàm Nhân Tu Tiên">
                <div class="rank-badge">4</div>
                <div class="rating-badge">4.4</div>
                <div class="card-body">
                    <h5 class="card-title text-truncate">Phàm Nhân Tu Tiên</h5>
                    <p class="card-text text-muted">Fanren Xiu Xian Chuan S3</p>
                </div>
            </div>
        </div>

        <div class="col" style="max-width: 250px;">
            <div class="card h-100 movie-card-item">
                <img src="/Banner/thegioi.jpg" class="card-img-top" alt="Thế Giới Hoàn Mỹ">
                <div class="rank-badge">5</div>
                <div class="rating-badge">4.3</div>
                <div class="card-body">
                    <h5 class="card-title text-truncate">Thế Giới Hoàn Mỹ</h5>
                    <p class="card-text text-muted">Fanren Xiu Xian Chuan S3</p>
                </div>
            </div>
        </div>
    </div>

</main>