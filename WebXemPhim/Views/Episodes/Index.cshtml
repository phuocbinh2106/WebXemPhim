@model IEnumerable<WebXemPhim.Models.Episode>

@{
    ViewBag.Title = "Danh Sách Tập Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4 align-items-center">
        <h2 class="text-light">Tập phim của bạn</h2>
        <a href="@Url.Action("Create", "Episodes")" class="btn btn-success">+ Thêm tập phim</a>
    </div>

    <div class="row g-3">
        @foreach (var ep in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card bg-dark text-light shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary">Tập @ep.EpisodeNumber</span>
                        <span class="badge bg-secondary">@ep.Title</span>
                    </div>
                    <div class="card-body p-3">
                        @if (!string.IsNullOrEmpty(ep.VideoUrl))
                        {
                            <video controls style="width:100%;max-height:120px;">
                                <source src="@ep.VideoUrl" type="video/mp4" />
                                Không hỗ trợ video.
                            </video>
                        }
                        <div class="mt-2 small">
                            <span class="badge bg-info text-dark me-2">Phim:@(ep.Film != null ? ep.Film.Title : "N/A")</span>
                            <span class="text-light"><i class="bi bi-calendar"></i> Ngày: @(ep.PublishedAt.HasValue ? ep.PublishedAt.Value.ToString("dd/MM/yyyy") : "")</span>
                        </div>
                        <div class="mt-2">
                            <span><i class="bi bi-eye"></i> @ep.ViewCount lượt xem</span>
                        </div>
                        <div class="mt-1 small text-muted">@ep.Title</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-1 pb-2">
                        <a href="@Url.Action("Edit", "Episodes", new { id = ep.EpisodeId })" class="btn btn-warning btn-sm me-2">Sửa</a>
                        <a href="@Url.Action("Details", "Episodes", new { id = ep.EpisodeId })" class="btn btn-primary btn-sm me-2">Chi tiết</a>
                        <a href="@Url.Action("Delete", "Episodes", new { id = ep.EpisodeId })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xoá không?');">Xóa</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: #0a0e21;
    }

    .card {
        border-radius: 0.8rem;
    }

    .card-header {
        font-weight: 500;
    }

    .card-title, .badge {
        font-weight: 500;
    }

    .btn {
        border-radius: 0.5rem;
    }
</style>
