@model WebXemPhim.Models.Episode
@{
    ViewBag.Title = "Thêm tập phim";
}

<h2 class="text-light mb-4">Thêm tập phim mới</h2>

@using (Html.BeginForm("Create", "Episodes", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="bg-dark text-light rounded p-4 shadow-lg" style="max-width:700px; margin:auto">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(m => m.Title, "Tên tập", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control bg-secondary text-light" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.EpisodeNumber, "Số thứ tự tập", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.EpisodeNumber, new { @class = "form-control bg-secondary text-light" })
        </div>

        <div class="mb-3">
            <label class="form-label" for="VideoFile">Video tập phim</label>
            <input type="file" id="VideoFile" name="VideoFile" class="form-control bg-secondary text-light" accept="video/mp4,video/webm,video/ogg,.mp4,.m4v,.webm,.ogg,.ogv" />
            <div class="form-text text-secondary">Bấm để chọn file video ở bất kỳ thư mục nào trên máy (mp4, webm, ogg).</div>
            @Html.ValidationMessage("VideoFile", "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.PublishedAt, "Ngày phát hành", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.PublishedAt, "{0:yyyy-MM-dd}", new { @class = "form-control bg-secondary text-light", type = "date" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.ViewCount, "Số lượt xem", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.ViewCount, new { @class = "form-control bg-secondary text-light", type = "number", min = "0" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.FilmId, "Phim", new { @class = "form-label" })
            @Html.DropDownList("FilmId", ViewBag.FilmId as SelectList, "---Chọn phim---", new { @class = "form-control bg-secondary text-light" })
        </div>

        <button type="submit" class="btn btn-light w-100 mt-3 fw-bold">Tạo tập phim</button>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
