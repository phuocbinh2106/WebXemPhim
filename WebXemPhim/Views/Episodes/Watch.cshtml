@model WebXemPhim.Models.Episode

@{
    ViewBag.Title = Model.Film.Title + " - Tập " + Model.EpisodeNumber;
}
<h3>@Model.Film.Title - Tập @Model.EpisodeNumber</h3>
@if (!string.IsNullOrEmpty(Model.VideoUrl))
{
    <video controls width="100%">
        <source src="@Model.VideoUrl" type="video/mp4" />
    </video>
}
else
{
    <div class="alert alert-warning">Chưa có video cho tập này.</div>
}
<a href="@Url.Action("Details", "Films", new { id = Model.FilmId })" class="btn btn-outline-light mt-2">Quay lại trang phim</a>

