@model WebXemPhim.Models.Episode

@{
    ViewBag.Title = "Chỉnh sửa tập phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-light shadow-lg border-0 rounded-3">
                <div class="card-body p-4">
                    <h2 class="mb-4 text-center">Chỉnh sửa tập phim</h2>
                    @using (Html.BeginForm("Edit", "Episodes", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.EpisodeId)

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Title, "Tên", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control bg-secondary text-light" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EpisodeNumber, "Số tập", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EpisodeNumber, new { @class = "form-control bg-secondary text-light" })
                            @Html.ValidationMessageFor(m => m.EpisodeNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.VideoUrl)
                            @Html.DropDownListFor( model => model.VideoUrl,ViewBag.VideoFiles as IEnumerable<SelectListItem>,"- Chọn file video -",new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.VideoUrl)
                        </div>
                            <div class="mb-3">
                                @Html.LabelFor(m => m.PublishedAt, "Ngày xuất bản", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.PublishedAt, new { @class = "form-control bg-secondary text-light", type = "date" })
                                @Html.ValidationMessageFor(m => m.PublishedAt, "", new { @class = "text-danger" })
                            </div>
                            <div class="mb-3">
                                @Html.LabelFor(m => m.ViewCount, "Số view", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.ViewCount, new { @class = "form-control bg-secondary text-light", @readonly = "readonly" })
                                @Html.ValidationMessageFor(m => m.ViewCount, "", new { @class = "text-danger" })
                            </div>
                            <div class="mb-3">
                                @Html.LabelFor(m => m.FilmId, new { @class = "form-label" })
                                @Html.DropDownList("FilmId", ViewBag.FilmId as SelectList, "Chọn phim...", new { @class = "form-control bg-secondary text-light" })
                                @Html.ValidationMessageFor(m => m.FilmId, "", new { @class = "text-danger" })
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-block">Lưu thay đổi</button>
                            </div>
                            <div class="mt-3 text-center">
                                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-light" })
                            </div>
                            }
                        </div>
                    </div>
        </div>
    </div>
</div>
