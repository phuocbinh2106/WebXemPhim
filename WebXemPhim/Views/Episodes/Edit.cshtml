@model WebXemPhim.Models.Episode

@{
    ViewBag.Title = "Chỉnh sửa tập phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="bg-dark text-light rounded p-4 shadow-lg" style="max-width:600px; margin:auto">
        <h2 class="mb-4 text-center">Chỉnh sửa tập phim</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                @Html.LabelFor(model => model.EpisodeNumber, "Số thứ tự tập", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.EpisodeNumber, new { @class = "form-control bg-secondary text-light" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Title, "Tên tập", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Title, new { @class = "form-control bg-secondary text-light" })
            </div>

            <div class="mb-3">
                <label class="form-label">Video tập phim</label>
                <input type="file" name="VideoFile" class="form-control bg-secondary text-light" accept="video/*" />
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.PublishedAt, "Ngày phát hành", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.PublishedAt, "{0:yyyy-MM-dd}", new { @class = "form-control bg-secondary text-light", type = "date" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ViewCount, "Lượt xem", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.ViewCount, new { @class = "form-control bg-secondary text-light", type = "number", min = "0" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.FilmId, "Phim", new { @class = "form-label" })
                @Html.DropDownList("FilmId", ViewBag.FilmId as SelectList, "---Chọn phim---", new { @class = "form-control bg-secondary text-light" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Title, "Mô tả tập phim", new { @class = "form-label" })
                @Html.TextAreaFor(model => model.Title, 3, 40, new { @class = "form-control bg-secondary text-light" })
            </div>

            <button type="submit" class="btn btn-light w-100 mt-3 fw-bold">Lưu thay đổi</button>
            <a href="@Url.Action("Index", "Episodes")" class="btn btn-outline-light w-100 mt-2">Về danh sách tập</a>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    body {
        background: #0a0e21;
    }

    .form-label {
        font-weight: 500;
    }

    .btn {
        border-radius: 0.5rem;
    }
</style>
